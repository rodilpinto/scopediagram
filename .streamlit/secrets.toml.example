# Segredos do llm_cadeia (ver llm_cadeia/README.md, seção "Segredos").
# Copie para .streamlit/secrets.toml (ignorado pelo git) ou cole em Secrets do Streamlit Cloud.
# Preencha só o que tiver; provedor sem chave é pulado. Nunca commite chaves reais.

# LLM local (Gemma do Nuati): só alcançável de dentro da rede da Câmara.
# No Streamlit Cloud é inalcançável: o `local` falha em 5 s e fica 5 min fora, por processo.
# Endereço real: só no exemplo privado do nuati-framework (segredos.exemplo.toml).
# LLM_BASE_URL = "http://<servidor-local>:<porta>/v1"
# LLM_MODEL = "google/gemma-4"

# Segunda chave (_2): outro login; qual conta é qual fica fora do repo (llm_cadeia/README.md).
GEMINI_API_KEY = ""
GEMINI_API_KEY_2 = ""
GROQ_API_KEY = ""
GROQ_API_KEY_2 = ""
CEREBRAS_API_KEY = ""
CEREBRAS_API_KEY_2 = ""
OPENROUTER_API_KEY = ""
OPENROUTER_API_KEY_2 = ""

# Opcionais:
# LLM_ORDEM = "gemini,gemini-2,groq"          # troca a ordem de tentativa
# GEMINI_MODELS = "gemini-3.5-flash-lite,gemini-3-flash-preview"   # troca a lista de modelos
# LLM_SOMENTE = "groq"                         # só estes provedores (teste); use no ambiente, não aqui
# LLM_TIMEOUT_S = "300"                        # espera máxima do `local`, em segundos
# LLM_DISABLE_THINKING = "1"                   # desliga o raciocínio do `local` (Gemma/Qwen)
